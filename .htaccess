# Apache URL Rewriting for Ankabit Farm (Pure HTML + processor.php)
RewriteEngine On
RewriteBase /

# 1. API Route -> processor.php
RewriteRule ^api/captcha/?$ processor.php?action=captcha [L,QSA]
RewriteRule ^api/leads/step1/?$ processor.php?action=step1 [L,QSA]
RewriteRule ^api/leads/step2/?$ processor.php?action=step2 [L,QSA]

# 2. Clean HTML URL Rewrites
RewriteRule ^$ index.html [L]
RewriteRule ^order/?$ order.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^terms/?$ terms.html [L]

# 3. Serve Existing Files Directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Fallback to index.html
RewriteRule . index.html [L]
